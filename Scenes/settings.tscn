[ext_resource type="AudioStream" uid="uid://dwdjwsbn8vlti" path="res://Assets/soundtrack/bit-beats-3-168873.mp3" id="5_music"]
[ext_resource type="Script" path="res://Scripts/soundtrack_credits.gd" id="6_loop"]

[sub_resource type="LabelSettings" id="LabelSettings_titulo"]
font = ExtResource("4_font")
font_size = 16
outline_size = 6
outline_color = Color(0, 0, 0, 1)

[node name="Settings" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")
script = ExtResource("1_set")

[node name="background" type="TextureRect" parent="."]
layout_mode = 0
offset_right = 240.0
offset_bottom = 427.0
texture = ExtResource("2_bg")
expand_mode = 1

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 0
offset_right = 240.0
offset_bottom = 427.0
theme_override_constants/margin_left = 30
theme_override_constants/margin_right = 30

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 10

[node name="titulo" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "SETTINGS"
label_settings = SubResource("LabelSettings_titulo")
horizontal_alignment = 1

[node name="musica_btn" type="Button" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "MUSIC ON"

[node name="volume_label" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_fonts/font = ExtResource("4_font")
theme_override_font_sizes/font_size = 11
text = "VOLUME 80"
horizontal_alignment = 1

[node name="volume_box" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="menos_btn" type="Button" parent="MarginContainer/VBoxContainer/volume_box"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "DOWN"

[node name="mais_btn" type="Button" parent="MarginContainer/VBoxContainer/volume_box"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "UP"

[node name="tela_cheia_btn" type="Button" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "FULLSCREEN OFF"

[node name="espaco" type="Control" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2

[node name="back_btn" type="Button" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "BACK"

[node name="AudioStreamPlayer" type="AudioStreamPlayer" parent="."]
stream = ExtResource("5_music")
autoplay = true
bus = &"Musica"
script = ExtResource("6_loop")

[connection signal="pressed" from="MarginContainer/VBoxContainer/musica_btn" to="." method="_on_musica_btn_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/volume_box/menos_btn" to="." method="_on_menos_btn_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/volume_box/mais_btn" to="." method="_on_mais_btn_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/tela_cheia_btn" to="." method="_on_tela_cheia_btn_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/back_btn" to="." method="_on_back_btn_pressed"]
[connection signal="finished" from="AudioStreamPlayer" to="AudioStreamPlayer" method="_on_finished"]
